import random
import datetime
from datetime import datetime
from zoneinfo import ZoneInfo

print("================================")
print("       WELCOME TO CHATBOT")
print("================================")
print("Type 'bye' to exit")

responses = {
    "hi": ["Hello!", "Hi! How are you?", "Welcome!"],
    "hello": ["Hello!", "Hey there!", "Nice to meet you!"],
    "how are you": ["I'm fine!", "Doing great!", "I'm good!"],
    "what is your name": ["I'm Python ChatBot!", "Call me ChatBot!"],
    "who created you": ["I was created using Python."],
    "what is python": ["Python is a programming language."],
    "thank you": ["You're welcome!", "Happy to help!"],
    "bye": ["Goodbye!", "See you again!", "Have a nice day!"]
}

while True:

    user = input("\nYou: ").lower().strip()

    if user == "bye":
        print("Bot:", random.choice(responses["bye"]))
        break

    elif user.startswith("my name is"):
        name = user.replace("my name is", "").strip()
        print("Bot: Nice to meet you,", name.title())

    elif user == "what is my name":
        if "name" in locals():
            print("Bot: Your name is", name.title())
        else:
            print("Bot: I don't know your name yet.")

    elif "time" in user:
       now = datetime.now(ZoneInfo("Asia/Kolkata"))
       print("Bot: Current time is", now.strftime("%I:%M:%S %p"))

    elif "date" in user:
         today = datetime.now(ZoneInfo("Asia/Kolkata"))
         print("Bot: Today's date is", today.strftime("%d-%m-%Y"))

    elif user in responses:
        print("Bot:", random.choice(responses[user]))

    else:
        print("Bot: Sorry, I don't understand that.")
        print("Bot: Please ask me something else.")
